{
  "name": "handwriting-ocr",
  "version": "0.2.0",
  "description": "Desktop app for transcribing historical handwriting with vision models.",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.okreitz.handwritingocr",
    "productName": "Handwriting OCR",
    "artifactName": "Handwriting-OCR-${os}-${arch}.${ext}",
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Handwriting-OCR-Setup.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
